APP_NAME=SmartCampus AI
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://smartcampus:smartcampus@localhost:5432/smartcampus
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
# Mode démo de l'authentification (en-tête X-Dev-Role) tant que /auth/login n'existe pas.
# Ignoré si ENVIRONMENT n'est pas development. Mettre false dès que SA-28 est livré.
AUTH_DEV_MODE=true
