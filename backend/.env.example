APP_NAME=SmartCampus AI
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://smartcampus:smartcampus@localhost:5432/smartcampus
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=30
# Comptes utilisateurs (SA-28)
REFRESH_TOKEN_DAYS=7
PASSWORD_MIN_LENGTH=8
# Sessions visiteur (SA-25)
GUEST_SESSION_TTL_HOURS=24
GUEST_MAX_MESSAGES=20
GUEST_RATE_LIMIT_PER_MINUTE=5
GUEST_PURGE_INTERVAL_MINUTES=60
# Mémoire temporaire des conversations (SA-26)
MEMORY_WINDOW_SIZE=10
MAX_MESSAGE_LENGTH=2000
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.2
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_DOCUMENTS_DIR=data/knowledge_base
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.25
